{
  "$comment": "The application's routes: for each, the CWA route policy and profile, the snapshot settings, and the model to send to per provider. For openai, the small route's model is a local one this example was run against through OPENAI_BASE_URL, and the large route's is gpt-oss-120b on Groq, whose key it reads from GROQ_API_KEY; replace them with yours. A route's base_url and api_key_env, when set, override OPENAI_BASE_URL and OPENAI_API_KEY for that route. escalate names the route to rebuild the snapshot on when an assembly refuses for that reason.",
  "default": "account-help-small",
  "routes": {
    "account-help-small": {
      "policy": "account-help-small/route-policy.json",
      "profile": "account-help-small/profile.json",
      "tokenizer": "estimate-utf8/v1",
      "renderer": "cwa-messages/v1",
      "budget": { "input": 1000, "reserved_output": 4000, "margin_percent": 15 },
      "retrieval": { "top_k": 5 },
      "escalate": { "protected_content_over_budget": "account-help" },
      "models": {
        "anthropic": { "model": "claude-haiku-4-5" },
        "openai": { "model": "gpt-oss-20b-MXFP4-Q8", "reasoning_effort": "low" }
      }
    },
    "account-help": {
      "policy": "account-help/route-policy.json",
      "profile": "account-help/profile.json",
      "tokenizer": "estimate-utf8/v1",
      "renderer": "cwa-messages/v1",
      "budget": { "input": 6000, "reserved_output": 16000, "margin_percent": 15 },
      "retrieval": { "top_k": 5 },
      "escalate": {},
      "models": {
        "anthropic": {
          "model": "claude-opus-5-5",
          "output_config": { "effort": "low" },
          "betas": ["server-side-fallback-2026-07-01"],
          "fallbacks": "default"
        },
        "openai": {
          "model": "openai/gpt-oss-120b",
          "base_url": "https://api.groq.com/openai/v1",
          "api_key_env": "GROQ_API_KEY"
        }
      }
    }
  }
}
