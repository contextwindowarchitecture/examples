# Copy to .env (gitignored) and run with `uv run --env-file .env agent.py ...` or `... evals.py run`. Variables
# already set in the environment win. The test suite never reads this file and never calls a model.

# Where requests go: none (print the first request), anthropic or openai.
DOCS_QA_PROVIDER=openai

# Who is signed in: u_ada (default, Owner), u_ben (Member) or u_cho (Admin), from data/accounts.json.
# DOCS_QA_USER=u_ada

# The route's openai model is a local gpt-oss-20b, the model its profile names (policy/routes.json).
OPENAI_BASE_URL=http://127.0.0.1:8000/v1
# OPENAI_API_KEY=

# The Claude API, for --provider anthropic. Or leave the key unset after `ant auth login`.
# ANTHROPIC_API_KEY=sk-ant-...

# A hosted model to evaluate, for example gpt-oss-120b on Groq (see README.md, The deployment gate).
# GROQ_API_KEY=gsk_...

# The snapshot store (default store/cwa.sqlite).
# DOCS_QA_STORE=store/cwa.sqlite

# Traces: print them, or send them to any OTLP/HTTP backend.
# DOCS_QA_TRACE_CONSOLE=1
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Langfuse: OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:3000/api/public/otel and
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 of public-key:secret-key>
